# Copy .env.uat.example for UAT or .env.production.example for production.
# Do not commit the completed .env file.
APP_ENV=development
APP_SECRET=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./app/data/tsco_platform.db
SEED_DEMO_DATA=true
SHOW_DEMO_ACCOUNTS=false
BOOTSTRAP_ADMIN_EMAIL=admin@tsco.local
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
REQUIRE_BOOTSTRAP_PASSWORD_CHANGE=true
ENABLE_PUBLIC_TRACKING=false
ENABLE_API_DOCS=true
PUBLIC_BASE_URL=http://localhost:8000
LMS_MODE=mock
LMS_API_BASE_URL=
LMS_API_TOKEN=
RUN_DATABASE_MIGRATIONS=true
