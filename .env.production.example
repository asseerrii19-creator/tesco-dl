APP_ENV=production
APP_PORT=8000
APP_SECRET=generate-a-long-random-secret-at-least-64-characters
POSTGRES_DB=tsco_platform
POSTGRES_USER=tsco_platform_app
POSTGRES_PASSWORD=replace-with-vault-managed-secret
SEED_DEMO_DATA=false
SHOW_DEMO_ACCOUNTS=false
BOOTSTRAP_ADMIN_EMAIL=platform-admin@tsco.example
BOOTSTRAP_ADMIN_NAME=TSCO Platform Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-one-time-vault-secret
REQUIRE_BOOTSTRAP_PASSWORD_CHANGE=true
ENABLE_PUBLIC_TRACKING=false
ENABLE_API_DOCS=false
PUBLIC_BASE_URL=https://lab.tsco.example
LMS_MODE=mock
LMS_API_BASE_URL=
LMS_API_TOKEN=
RUN_DATABASE_MIGRATIONS=true
