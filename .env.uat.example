APP_ENV=uat
APP_PORT=8000
APP_SECRET=generate-a-long-random-secret-at-least-48-characters
POSTGRES_DB=tsco_platform_uat
POSTGRES_USER=tsco_uat
POSTGRES_PASSWORD=replace-with-strong-uat-password
SEED_DEMO_DATA=true
SHOW_DEMO_ACCOUNTS=false
BOOTSTRAP_ADMIN_EMAIL=admin@tsco.local
BOOTSTRAP_ADMIN_NAME=TSCO Platform Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-one-time-temporary-password
REQUIRE_BOOTSTRAP_PASSWORD_CHANGE=true
ENABLE_PUBLIC_TRACKING=false
ENABLE_API_DOCS=true
PUBLIC_BASE_URL=https://tsco-lab-uat.example.com
LMS_MODE=mock
LMS_API_BASE_URL=
LMS_API_TOKEN=
RUN_DATABASE_MIGRATIONS=true
